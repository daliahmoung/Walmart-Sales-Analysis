-- =====================================================
-- Walmart Sales Analysis — SQL Queries
-- Business Question: How do fuel prices, CPI, and unemployment
-- relate to Walmart's weekly sales, and does that relationship
-- hold consistently across stores?
-- =====================================================
 
 
-- =====================================================
-- QUERY 1: BASELINE
-- What's the average weekly sales across all stores, and what's
-- the range (min/max) between the highest- and lowest-performing stores?
-- =====================================================
 
-- Overall average weekly sales across all stores
SELECT AVG(weekly_sales)
FROM walmart_sales;
 
-- Range between lowest and highest performing store (by store average)
WITH avgweekly_sales AS (
SELECT store, AVG(Weekly_Sales) AS avg_sales
FROM walmart_sales
GROUP BY store)
SELECT MIN(avg_sales), MAX(avg_sales)
FROM avgweekly_sales;
 
 
-- =====================================================
-- QUERY 2: FUEL PRICE RELATIONSHIP
-- Does weekly sales move with fuel price?
-- =====================================================
 
-- Overall average fuel price across the dataset
SELECT AVG(fuel_price)
FROM walmart_sales;
 
-- Store-level average sales vs. average fuel price, side by side
WITH avgweekly_sales AS (
SELECT store, AVG(Weekly_Sales) AS avg_sales, AVG(fuel_price) AS avgfuel_price
FROM walmart_sales
GROUP BY store)
SELECT avg_sales, avgfuel_price, store
FROM avgweekly_sales
ORDER BY avgfuel_price DESC;
 
